# ---- Hostinger MySQL DB details (from hPanel -> Databases -> MySQL Databases) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_3dcasemakers
DB_PASSWORD=your_db_password_here
DB_NAME=u123456789_3dcasemakers

# ---- Server ----
PORT=5000
NODE_ENV=production

# ---- Admin auth ----
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_EMAIL=3dcasemakers@gmail.com
ADMIN_PASSWORD=change_this_password

# ---- "Sign in with Google" on the admin login page ----
# Create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, add your admin login
# page URL (e.g. https://3dcasemakers.store) under "Authorized JavaScript
# origins", then paste the Client ID here. Must match VITE_GOOGLE_CLIENT_ID
# in frontend/.env.production exactly. The Google account signing in must
# use the SAME email as an existing row in the `admins` table.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ---- CORS: your frontend domain ----
CLIENT_URL=https://3dcasemakers.in

# ---- Public URL of THIS backend (used to build absolute og:image URLs
# for WhatsApp/social link-preview cards in routes/share.js) ----
BACKEND_PUBLIC_URL=https://api.3dcasemakers.in

# ---- Payment ----
# Cash on Delivery (COD) only — no payment gateway keys needed.

# ---- Order confirmation emails (Gmail SMTP via Nodemailer) ----
# EMAIL_USER: the Gmail address emails are sent FROM (e.g. your store's Gmail).
# EMAIL_PASS: a 16-character Gmail APP PASSWORD — NOT your normal Gmail
# password. Google blocks normal-password SMTP logins. See the setup guide
# for how to generate one. If these two are left blank, order confirmation
# emails are simply skipped (logged, never blocks order placement).
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# ---- Owner "new order" notification emails (Gmail SMTP via Nodemailer) ----
# Separate mailbox from EMAIL_USER above, purely for notifying the store
# owner every time a new order comes in. Sends FROM ORDERS_EMAIL_USER TO
# OWNER_EMAIL, with the order's details plus a running count/total of
# orders placed so far today.
# ORDERS_EMAIL_USER: the Gmail address these notifications are sent FROM
#   (e.g. 3dcasemakers.orders@gmail.com).
# ORDERS_EMAIL_PASS: a 16-character Gmail APP PASSWORD for that account
#   (NOT its normal password — same app-password rule as EMAIL_PASS above).
# OWNER_EMAIL: the owner's inbox these notifications are sent TO
#   (e.g. 3dcasemakers@gmail.com).
# If any of the three are left blank, owner notifications are simply
# skipped (logged, never blocks order placement).
ORDERS_EMAIL_USER=3dcasemakers.orders@gmail.com
ORDERS_EMAIL_PASS=your_orders_gmail_app_password
OWNER_EMAIL=3dcasemakers@gmail.com

# ---- File uploads (served from /uploads, stored on Hostinger disk) ----
# CRITICAL: This MUST be an ABSOLUTE path OUTSIDE your app's deployed code
# folder. On Hostinger, every time you re-upload/redeploy your zip, the app
# folder (domains/yourdomain.com/... or wherever your Node app root is) gets
# fully replaced - so anything stored inside it (like a plain "uploads"
# relative folder) gets deleted too. Storing outside that folder means
# redeploys never touch it.
#
# Example (replace u123456789 with your actual Hostinger username, run
# `pwd` in Hostinger Node.js terminal / SSH to confirm your home path):
# UPLOAD_DIR=/home/u123456789/3dcasemakers_uploads
UPLOAD_DIR=/home/u123456789/3dcasemakers_uploads
MAX_UPLOAD_MB=5
