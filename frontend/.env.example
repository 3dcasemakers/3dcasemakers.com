# URL where your backend API is reachable (Node.js app on Hostinger).
# Example if backend is deployed on the same domain under /api via Node app on port from hPanel:
VITE_API_URL=https://api.3dcasemakers.in

# "Sign in with Google" on the admin login page — same Client ID as
# GOOGLE_CLIENT_ID in backend/.env (see that file for setup steps).
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

