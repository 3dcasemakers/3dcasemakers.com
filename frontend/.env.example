# URL where your backend API is reachable (Node.js app on Hostinger).
# Example if backend is deployed on the same domain under /api via Node app on port from hPanel:
VITE_API_URL=https://api.3dcasemakers.com

VITE_SITE_URL=https://3dcasemakers.com

# Optional Google admin sign-in; leave blank to use email/password only.
# Must match GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=
